DATABASE_URL=postgres://user:pass@host:5432/db
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=gere-com-openssl-rand-base64-32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# E-mails autorizados a entrar, separados por vírgula
ALLOWED_EMAILS=
# E-mail (Esqueci a senha) pelo Resend. Sem chave em dev, o e-mail aparece no terminal.
RESEND_API_KEY=
EMAIL_FROM="Bubbly <nao-responda@bubbly.app.br>"
# Notificações no app da loja (web E worker). Sem elas, o app mostra "chegam em breve".
# Android: JSON da conta de serviço do Firebase (texto ou base64)
FCM_SERVICE_ACCOUNT=
# iPhone: chave .p8 do APNs (texto ou base64), id da chave e Team ID da conta Apple
APNS_KEY=
APNS_KEY_ID=
APPLE_TEAM_ID=
# APNS_SANDBOX=1 só para build de desenvolvimento no Xcode
